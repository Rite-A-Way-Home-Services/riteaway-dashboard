# ── Access control ──────────────────────────────────────────────
# Shared team password for the dashboard. If unset, the dashboard is OPEN.
DASHBOARD_PASSWORD=

# ── Housecall Pro ────────────────────────────────────────────────
# Settings → API in Housecall Pro. If unset, the app runs in MOCK mode.
HCP_API_KEY=
# Auth scheme HCP expects: "Bearer" (default) or "Token". Flip if you get 401s.
HCP_AUTH_SCHEME=Bearer
HCP_BASE_URL=https://api.housecallpro.com

# ── Ringba ───────────────────────────────────────────────────────
RINGBA_API_TOKEN=
RINGBA_ACCOUNT_ID=
RINGBA_BASE_URL=https://api.ringba.com/v2

# ── Business settings ────────────────────────────────────────────
# Default monthly break-even target (editable live in the dashboard UI)
BREAK_EVEN_MONTHLY=85000
# Used for "all-time" period start and break-even proration
BUSINESS_START=2024-01-01
# Override tech headcount for utilization; if unset, counted from HCP employees
TECH_COUNT=
WORK_HOURS_PER_DAY=8

# ── Google Business Profile rating (public Places API — key only) ──
# Cloud console → enable "Places API (New)" → create an API key.
GOOGLE_PLACES_API_KEY=
# Either the exact place ID…
GOOGLE_PLACE_ID=
# …or a search string we resolve once (e.g. "Rite-A-Way Garage Doors Phoenix")
GOOGLE_PLACE_QUERY=

# ── Google Ads (OAuth + approved developer token required) ────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Only if the account sits under a manager (MCC) account:
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ── Technicians counted in utilization (dashboard picker overrides) ─
TECH_NAMES=

# ── Optional: Upstash Redis (free tier) for team-wide persistence of
#    the break-even target. Without it, edits fall back to the env default
#    when the serverless instance recycles.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
